# Google Drive API Configuration

# Central mode (default for the deployed app):
# Put YOUR Google OAuth Client ID here. It is baked into the build, and every
# user simply signs in with their own Google account — no setup required.
VITE_GOOGLE_CLIENT_ID=

# Optional: specific Google Drive folder ID to list songs from.
# Leave empty to let each user pick their folder inside the app after signing in.
VITE_GOOGLE_DRIVE_FOLDER_ID=
